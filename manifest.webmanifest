{
  "name": "Switchboard",
  "short_name": "Switchboard",
  "description": "One link on every sticker, sent on to the app that owns it.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#F1EFE8",
  "theme_color": "#F1EFE8",
